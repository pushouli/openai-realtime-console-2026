# =============================================================================
# 小车（car-v2）部署的配置样例
#
# 这是一份完整的配置，不是片段。部署小车时复制成 .env 再填 VITE_API_KEY：
#
#   cp .env.car-v2 .env
#
# 实际生效的永远是 .env，本文件只作参考、不会被读取。
# 因为不含密钥，所以可以提交；密钥只写进 .env（已在 .gitignore 中）。
#
# -----------------------------------------------------------------------------
# 和 main 部署的根本区别
# -----------------------------------------------------------------------------
# main：静态文件直接放进 Bot 项目里，所以同源、天然带登录态，
#       接口写相对路径即可，靠 Cookie 认身份。
#
# car ：独立站点，跨域、没有登录态，
#       所以接口必须写绝对地址，靠 ApiKey 认身份。
#
# 【注意跨域】代码检测到 VITE_API_KEY 有值时会自动改用 credentials: "omit"。
# 因为跨域携带 Cookie 要求服务端返回 Access-Control-Allow-Credentials，
# 而你们 Realtime 的 CORS 策略里 SupportsCredentials 是注释掉的。
#
# 【要改服务端】小车站点的域名（以及开发时的 http://localhost:5173）
# 得加进 appsettings.json 的 Cors:Realtime:Origins，否则浏览器直接拦掉。
# 现在那里只有 http://localhost:3000。
# =============================================================================


# -----------------------------------------------------------------------------
# 身份：小车必须配 ApiKey
# -----------------------------------------------------------------------------
# 建连接口 Calls 要求身份：登录 Cookie 或 ApiKey 二选一。小车没有登录态，
# 所以这一项必填，否则建连直接 401。
# 值对应服务端 appsettings 的 Authentication:Schemes:ApiKey:Key。
#
# 【别提交】这里留空，真正的值填在 .env 里。
VITE_API_KEY=


# -----------------------------------------------------------------------------
# 后端接口（跨域，必须绝对地址）
# -----------------------------------------------------------------------------
# 下面的域名按你们实际部署的 Bot 站点地址填。

# 建连：内部完成换临时密钥 + 交换 SDP
VITE_CALLS_SERVER_URL=https://bot.pushouli.top/api/realtime/Calls

# 配置：走免鉴权的 Configuration2，key 固定 car-v2，
# 对应服务端 Instructions/car-v2.json。
#
# 【注意】Configuration2 是纯读文件返回，不会像 Configuration 那样合并
# system.json 里的 system_instructions。所以系统提示词要直接写进
# car-v2.json 的 instructions 字段里，前端的拼接逻辑对它是空转。
VITE_CONFIGURATION_SERVER_URL=https://bot.pushouli.top/api/realtime/Configuration2/car-v2


# -----------------------------------------------------------------------------
# 关掉需要登录的接口
# -----------------------------------------------------------------------------
# 这些接口都带 [BotAuthorize]，小车只有 ApiKey、过不了 Cookie 认证。
# 留空即关闭：代码判断到空地址会直接跳过，不发请求、不报错。

# 动态工具。关掉后只剩内置的 execute_python 和 see_with_camera。
VITE_TOOLS_SERVER_URL=

# 会话记录四件套。
VITE_CREATE_SESSION_URL=
VITE_ADD_SESSION_CONFIG_RECORD_URL=
VITE_ADD_MESSAGE_URL=
VITE_END_SESSION_URL=


# -----------------------------------------------------------------------------
# 门户样式表
# -----------------------------------------------------------------------------
# 页面 header 用的 .page-header / .logo / .logo-pic / .logo-text 出自这个文件。
# vite.config.js 读到这一项后往 index.html 的 <head> 注入一个 link 标签。
#
# 小车是独立站点，本地没有这个文件，只能写绝对地址。
#
# 【已知问题】样式表本身跨域能加载（stylesheet 不需要 CORS），但它 @import 的
# 三套字体里全是 @font-face，而字体文件跨域必须带 Access-Control-Allow-Origin。
# ai.ycyw.com/fonts/* 目前不返回这个头，所以小车上字体会被浏览器静默拦掉、
# 掉回系统字体。不报错，只是长得不一样。要修得在门户那边给字体加 CORS 头。
VITE_SITE_CSS=https://ai.ycyw.com/css/site.css


# -----------------------------------------------------------------------------
# 小车控制后端
# -----------------------------------------------------------------------------
# 这一项只有小车部署用得上——main 的 deploymentTools 是空的，没人读它。
#
# execute_python 打 {这里}api/exec，see_with_camera 打 {这里}api/visual。
# 默认与页面同源。如果小车服务在别的地址（比如页面部署在服务器、
# 小车在局域网某个 IP），改成完整地址，结尾要带斜杠。
#
# /api/visual 在小车侧有两个入口，按请求方法分流：
#
#   GET    只拍照，返回 { "image": "<base64 JPEG，不含 data: 前缀>" }。
#          see_with_camera 走这条：前端把图直接插进对话让模型自己看，
#          省掉一趟 Dify 往返，也能就同一张图追问而不用重拍。
#          小车侧已缩到 768px 宽：图像按 token 计费，1080p 原图又贵又慢。
#          拍照失败返回 { "error": "..." }，原样交给模型说出来，不打断通话。
#
#   POST   带 prompt，拍照后上传 Dify 跑视觉工作流、返回文字分析。
#          语音模型还看不见图的年代留下的路径，原样保留但前端不再用。
VITE_CAR_ENDPOINT=/
