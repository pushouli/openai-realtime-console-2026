# =============================================================================
# 复制本文件为 .env 后按需修改。
#
# 本项目是纯静态页，没有自己的服务端。建连、会话配置、动态工具、会话记录
# 全部来自你们的后端，Realtime 流量走你们的中转。
#
# 本文件面向 main 的部署形态：构建产物直接放进 Bot 项目里，
# 所以同源、天然带登录态——接口用相对路径，靠 Cookie 认身份，
# 生产环境几乎不用配任何东西。
#
# 独立站点（比如小车）是另一回事：跨域、无登录态，接口要写绝对地址、
# 靠 ApiKey 认身份。那种配置见 .env.car-v2。
#
# 变量分两类：
#   VITE_ 开头 —— 会被打包进前端代码，浏览器里可见，不要放任何密钥
#   无前缀     —— 只有 vite.config.js 读得到，仅开发时生效，不会打包
#
# 大部分变量保持默认即可，proxy 转发那项按你们实际情况确认。
# =============================================================================


# -----------------------------------------------------------------------------
# 模型
# -----------------------------------------------------------------------------
# 默认 gpt-realtime-2.1（2026-07 发布，支持原生图像输入和可配置推理强度）。
# 只接受 realtime 系列——后端 Sessions 那边按前缀做了白名单。
# VITE_REALTIME_MODEL=gpt-realtime-2.1


# -----------------------------------------------------------------------------
# ApiKey（main 部署不需要）
# -----------------------------------------------------------------------------
# 建连接口接受两种身份之一：浏览器登录 Cookie，或这个 ApiKey。
# main 装在 Bot 项目里、天然有登录态，所以这项留空即可。
#
# 只有独立站点才需要。一旦填了，代码会自动改用 credentials: "omit"
# ——跨域携带 Cookie 需要服务端返回 Access-Control-Allow-Credentials，
# 而 Realtime 的 CORS 策略没开这个。
#
# 【重要】它会被打进 JS 包，任何人都能从浏览器里看到。它的作用是标识部署、
# 挡掉随手扫描，不是真正的访问控制。
#
# 【别提交】只写在 .env 里（已在 .gitignore 中）。
# VITE_API_KEY=


# -----------------------------------------------------------------------------
# 建连接口
# -----------------------------------------------------------------------------
# 浏览器把 SDP offer 和会话参数一起 POST 到这里，后端内部完成
# 「换临时密钥 + 交换 SDP」两步，返回 answer SDP。
#
# 这样浏览器不持有任何凭证，也没有跨域请求。
# 注意媒体流不经过这里——SDP 换完之后音频是浏览器直连媒体服务器的。
# VITE_CALLS_SERVER_URL=/api/realtime/Calls


# -----------------------------------------------------------------------------
# 后端接口地址
# -----------------------------------------------------------------------------
# 生产环境前端和接口同源，写相对路径即可；
# 开发环境由文件末尾的 API_PROXY_TARGET 转发过去。
# 所有请求都带 cookie（credentials: 'include'）。

# -----------------------------------------------------------------------------
# 会话配置从哪来：三种来源，一条规则
# -----------------------------------------------------------------------------
# 服务端历史上长出了三个配置入口，各有各的用途，前端用一条规则统一选择：
#
#   URL 带 ?instructions=xxx  →  读 VITE_INSTRUCTIONS_SERVER_URL/xxx
#   否则                      →  读 VITE_CONFIGURATION_SERVER_URL
#
# 三个入口的区别：
#
#   Instructions/{key}    免登录，存 {key}.txt，最早加的，只管提示词。
#                         内容可以是纯文本（整段当提示词），也可以是完整 JSON。
#                         合并 system.json 的 system_instructions。
#                         用 URL 参数切换，适合几个固定的提示词变体。
#
#   Configuration         需登录，存 {当前用户ID}.json，每个用户一份，
#                         可以调声音、VAD 等全部参数。合并 system_instructions。
#
#   Configuration2/{key}  免登录，存 {key}.json，为小车这类无登录场景加的。
#                         **不合并** system_instructions，提示词要写全在文件里。
#
# 【注意】带 ?instructions= 时页面不显示 Setup 按钮——那份配置是按 URL 寻址的
# 共享文件，不是当前用户的设置，存回去会写错地方。原版在那种部署下干脆没有
# 配置弹窗，这里保持一致。
VITE_CONFIGURATION_SERVER_URL=/api/realtime/Configuration

# ?instructions= 生效时读的地址，一般不用改
VITE_INSTRUCTIONS_SERVER_URL=/api/realtime/Instructions

# 工具编辑器里「Import from Dify」用的地址。默认 https://dify.ycyw.com。
# 输入某个 Dify 工作流的 ApiKey，会去读它的 /v1/info 和 /v1/parameters，
# 自动生成工具定义和调用该工作流的 handler。
# VITE_DIFY_URL=https://dify.ycyw.com

# 动态工具。GET 返回工具数组，PUT 整体覆盖
# 【安全提醒】工具的 handler 是 JS 源码，前端用 new Function 执行。
# 也就是说这个接口的写权限 == 所有用户浏览器里的代码执行权限，务必确认鉴权。
VITE_TOOLS_SERVER_URL=/api/realtime/Tools

# 会话记录四件套。失败只记日志、不打断通话。
# 【留空即关闭】没有登录态的部署（比如小车）把这四项留空，代码会直接跳过，
# 不发请求也不报错。
VITE_CREATE_SESSION_URL=/api/realtime/CreateSession
VITE_ADD_SESSION_CONFIG_RECORD_URL=/api/realtime/AddSessionConfigRecord
VITE_ADD_MESSAGE_URL=/api/realtime/AddMessage
VITE_END_SESSION_URL=/api/realtime/EndSession


# -----------------------------------------------------------------------------
# 门户样式表
# -----------------------------------------------------------------------------
# 页面 header 用的 .page-header / .logo / .logo-pic / .logo-text 出自这个文件。
# vite.config.js 读到这一项后往 index.html 的 <head> 注入一个 link 标签。
#
# 写门户的绝对地址，构建产物放到哪都能取到，不依赖部署位置是否同源。
#
# 【已知问题】样式表本身跨域能加载（stylesheet 不需要 CORS），但它 @import 的
# 三套字体里全是 @font-face，而字体文件跨域必须带 Access-Control-Allow-Origin。
# ai.ycyw.com/fonts/* 目前不返回这个头，所以只要页面不和门户同源，
# 字体就会被浏览器静默拦掉、掉回系统字体。不报错，只是长得不一样。
#
# 【留空即不注入】不写这一项就完全不生成 link 标签，header 会掉成无样式。
VITE_SITE_CSS=https://ai.ycyw.com/css/site.css


# -----------------------------------------------------------------------------
# 语音转写模型
# -----------------------------------------------------------------------------
# 默认 whisper-1，和你们现在用的一致。
# 若中转已支持新模型，可换成 gpt-4o-mini-transcribe 或 gpt-realtime-whisper。
# 转写结果用于界面显示。
# VITE_TRANSCRIBE_MODEL=whisper-1


# -----------------------------------------------------------------------------
# 开发服务器转发（仅开发时生效，不会打包）
# -----------------------------------------------------------------------------
# 开发时页面在 localhost:5173，接口在另一个域，而所有请求都要带 cookie。
# 跨域带 cookie 限制多，所以用转发把接口做成同源。
#
# 不填的话 /api 不会被转发，页面能打开但所有接口都会 404。
# 生产构建出来的静态包不需要这个（前端和接口本来就同源）。
API_PROXY_TARGET=https://bot.pushouli.top
